# Cat S22 Flip (QM215) additions on top of the postmarketOS msm89x7 config
CONFIG_TYPEC=m
CONFIG_TYPEC_WUSB3801=m
CONFIG_VIDEO_DW9714=m
# Outer SPI display: built in, because SPI devices only advertise
# "spi:s22flip-ext-panel", which no module alias matches
CONFIG_BACKLIGHT_GPIO=y
CONFIG_DRM_PANEL_MIPI_DBI=y
# Main ST7701S DSI panel (generated with linux-mdss-dsi-panel-driver-generator)
CONFIG_DRM_PANEL_CAT_S22FLIP_ST7701S=m
# AW88194 loudspeaker amplifier (local driver, DSP bypassed)
CONFIG_SND_SOC_AW88194=m
# Main display touchscreen (local driver)
CONFIG_TOUCHSCREEN_CHIPSEMI_CHSC=m
# Front camera (local driver)
CONFIG_VIDEO_GC02M2=m
