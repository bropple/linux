# Cat S22 Flip (QM215) additions on top of the postmarketOS msm89x7 config
CONFIG_TYPEC=m
CONFIG_TYPEC_WUSB3801=m
CONFIG_VIDEO_DW9714=m
# Outer SPI display: built in, because SPI devices only advertise
# "spi:s22flip-ext-panel", which no module alias matches
CONFIG_BACKLIGHT_GPIO=y
CONFIG_DRM_PANEL_MIPI_DBI=y
